
@model LearnTrack.Models.ApplicationUser

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-page {
        color: #172554;
    }

    .glass-panel {
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(255, 255, 255, 0.85);
        border-radius: 26px;
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        box-shadow: 0 12px 40px rgba(23, 37, 84, 0.07);
    }

    .dashboard-hero {
        position: relative;
        overflow: hidden;
        border-radius: 30px;
        padding: 48px;
        color: white;
        background: linear-gradient(120deg, #172554, #2563EB);
        box-shadow: 0 20px 50px rgba(37, 99, 235, 0.18);
    }

    .dashboard-hero::before,
    .dashboard-hero::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.09);
        pointer-events: none;
    }

    .dashboard-hero::before {
        width: 260px;
        height: 260px;
        top: -110px;
        right: 8%;
    }

    .dashboard-hero::after {
        width: 180px;
        height: 180px;
        bottom: -100px;
        right: 28%;
    }

    .hero-content,
    .hero-icon {
        position: relative;
        z-index: 1;
    }

    .hero-icon {
        font-size: 100px;
        opacity: 0.85;
    }

    .dashboard-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 15px;
        border-radius: 50px;
        color: white;
        background: rgba(255, 255, 255, 0.16);
        border: 1px solid rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(12px);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .glass-card {
        height: 100%;
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(255, 255, 255, 0.9);
        border-radius: 24px;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 10px 35px rgba(23, 37, 84, 0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .glass-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 40px rgba(37, 99, 235, 0.12);
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        font-size: 1.4rem;
        background: rgba(37, 99, 235, 0.09);
        color: #2563EB;
    }

    .stat-value {
        color: #172554;
        font-size: 2.1rem;
        font-weight: 800;
        letter-spacing: -1px;
    }

    .dashboard-link {
        color: #2563EB;
        font-weight: 700;
        text-decoration: none;
    }

    .dashboard-link:hover {
        color: #172554;
    }

    .section-label {
        color: #2563EB;
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 1.5px;
    }

    .section-heading {
        color: #172554;
        font-weight: 800;
    }

    .management-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 19px;
        background: rgba(37, 99, 235, 0.09);
        color: #2563EB;
        font-size: 1.7rem;
    }

    .glass-button {
        border-radius: 13px;
        padding: 10px 18px;
        font-weight: 600;
    }

    .chart-container {
        position: relative;
        height: 330px;
    }

    .dashboard-journey {
        background: linear-gradient(
            120deg,
            rgba(255, 255, 255, 0.85),
            rgba(219, 234, 254, 0.65)
        );
    }

    @@media (max-width: 767.98px) {
        .dashboard-hero {
            padding: 30px 23px;
            border-radius: 23px;
        }

        .hero-icon {
            font-size: 65px;
            margin-top: 20px;
        }

        .stat-value {
            font-size: 1.8rem;
        }

        .chart-container {
            height: 280px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .glass-card {
            transition: none;
        }

        .glass-card:hover {
            transform: none;
        }
    }
</style>

<div class="container py-5 dashboard-page">

    <!-- Welcome Banner -->
    <section class="dashboard-hero mb-5">
        <div class="row align-items-center">
            <div class="col-md-9 hero-content">

                <span class="dashboard-badge mb-3">
                    <i class="bi bi-stars"></i>
                    LEARNTRACK DASHBOARD
                </span>

                <h1 class="fw-bold mb-3">
                    Welcome back, @Model.FirstName!
                </h1>

                <p class="mb-0 opacity-75 fs-6">
                    Here's an overview of your learning journey.
                    Keep learning, stay focused and achieve your goals.
                </p>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a asp-controller="Courses"
                       asp-action="Create"
                       class="btn btn-light text-primary fw-semibold glass-button">
                        <i class="bi bi-plus-lg me-2"></i>
                        Add a Course
                    </a>

                    <a asp-controller="StudyGoals"
                       asp-action="Create"
                       class="btn btn-outline-light glass-button">
                        <i class="bi bi-bullseye me-2"></i>
                        Set a Goal
                    </a>
                </div>
            </div>

            <div class="col-md-3 text-md-end text-center hero-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
        </div>
    </section>

    <!-- Learning Overview -->
    <section class="mb-4">
        <span class="section-label">YOUR PERFORMANCE</span>
        <h3 class="section-heading mt-1 mb-1">Learning Overview</h3>
        <p class="text-muted mb-0">
            A quick look at your courses, progress and achievements.
        </p>
    </section>

    <!-- Statistics -->
    <div class="row g-4 mb-5">

        <!-- Total Courses -->
        <div class="col-md-6 col-xl-3">
            <div class="glass-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="text-muted fw-semibold">Total Courses</span>
                    <div class="stat-icon">
                        <i class="bi bi-book-fill"></i>
                    </div>
                </div>

                <div class="stat-value mb-3">@ViewBag.TotalCourses</div>

                <a asp-controller="Courses"
                   asp-action="Index"
                   class="dashboard-link">
                    View Courses <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <!-- Average Progress -->
        <div class="col-md-6 col-xl-3">
            <div class="glass-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="text-muted fw-semibold">Average Progress</span>
                    <div class="stat-icon text-success"
                         style="background: rgba(25, 135, 84, 0.10);">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>

                <div class="stat-value mb-3">
                    @ViewBag.AverageProgress%
                </div>

                <a asp-controller="Progress"
                   asp-action="Index"
                   class="dashboard-link">
                    View Progress <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <!-- Total Goals -->
        <div class="col-md-6 col-xl-3">
            <div class="glass-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="text-muted fw-semibold">Total Goals</span>
                    <div class="stat-icon text-warning"
                         style="background: rgba(255, 193, 7, 0.13);">
                        <i class="bi bi-bullseye"></i>
                    </div>
                </div>

                <div class="stat-value mb-3">@ViewBag.TotalGoals</div>

                <a asp-controller="StudyGoals"
                   asp-action="Index"
                   class="dashboard-link">
                    View Goals <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <!-- Completed Goals -->
        <div class="col-md-6 col-xl-3">
            <div class="glass-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="text-muted fw-semibold">Completed Goals</span>
                    <div class="stat-icon text-success"
                         style="background: rgba(25, 135, 84, 0.10);">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>

                <div class="stat-value text-success mb-3">
                    @ViewBag.CompletedGoals
                </div>

                <a asp-controller="StudyGoals"
                   asp-action="Index"
                   class="dashboard-link">
                    View Achievements <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

    </div>

    <!-- Course Progress Chart -->
    <section class="glass-panel p-4 p-md-5 mb-5">

        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="stat-icon">
                <i class="bi bi-bar-chart-line-fill"></i>
            </div>

            <div>
                <h4 class="section-heading mb-1">
                    Course Progress Overview
                </h4>
                <p class="text-muted mb-0">
                    Monitor your completion percentage across your courses.
                </p>
            </div>
        </div>

        @if ((int)ViewBag.TotalCourses > 0)
        {
            <div class="chart-container">
                <canvas id="courseProgressChart"
                        aria-label="Bar chart showing progress for each course"
                        role="img"></canvas>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-journal-plus display-3 text-primary"></i>

                <h5 class="fw-bold mt-3">No courses added yet</h5>

                <p class="text-muted">
                    Add your first course to start tracking your learning progress.
                </p>

                <a asp-controller="Courses"
                   asp-action="Create"
                   class="btn btn-primary glass-button">
                    <i class="bi bi-plus-lg me-2"></i>
                    Add Your First Course
                </a>
            </div>
        }

    </section>

    <!-- Learning Management -->
    <section class="mb-4">
        <span class="section-label">MANAGE YOUR STUDIES</span>
        <h3 class="section-heading mt-1 mb-1">Learning Management</h3>
        <p class="text-muted mb-0">
            Everything you need to manage your learning journey.
        </p>
    </section>

    <div class="row g-4 mb-5">

        <!-- Courses -->
        <div class="col-md-4">
            <div class="glass-card p-4">
                <div class="management-icon mb-3">
                    <i class="bi bi-book-half"></i>
                </div>

                <h5 class="fw-bold">My Courses</h5>

                <p class="text-muted">
                    Organise, add and manage all your learning courses
                    in one place.
                </p>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a asp-controller="Courses"
                       asp-action="Index"
                       class="btn btn-primary glass-button">
                        View Courses
                    </a>

                    <a asp-controller="Courses"
                       asp-action="Create"
                       class="btn btn-outline-primary glass-button">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add Course
                    </a>
                </div>
            </div>
        </div>

        <!-- Progress -->
        <div class="col-md-4">
            <div class="glass-card p-4">
                <div class="management-icon mb-3"
                     style="color: #198754; background: rgba(25, 135, 84, 0.10);">
                    <i class="bi bi-activity"></i>
                </div>

                <h5 class="fw-bold">My Progress</h5>

                <p class="text-muted">
                    Monitor your course completion and measure
                    your academic development.
                </p>

                <a asp-controller="Progress"
                   asp-action="Index"
                   class="btn btn-primary glass-button mt-4">
                    View My Progress
                    <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <!-- Study Goals -->
        <div class="col-md-4">
            <div class="glass-card p-4">
                <div class="management-icon mb-3"
                     style="color: #d69e00; background: rgba(255, 193, 7, 0.13);">
                    <i class="bi bi-flag-fill"></i>
                </div>

                <h5 class="fw-bold">Study Goals</h5>

                <p class="text-muted">
                    Set learning targets, manage deadlines and
                    celebrate your achievements.
                </p>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a asp-controller="StudyGoals"
                       asp-action="Index"
                       class="btn btn-primary glass-button">
                        View Goals
                    </a>

                    <a asp-controller="StudyGoals"
                       asp-action="Create"
                       class="btn btn-outline-primary glass-button">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add Goal
                    </a>
                </div>
            </div>
        </div>

    </div>

    <!-- Learning Journey -->
    <section class="glass-panel dashboard-journey p-4 p-md-5">
        <div class="d-flex align-items-center gap-3">
            <div class="stat-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <div>
                <h4 class="section-heading mb-1">
                    Your Learning Journey
                </h4>

                <p class="text-muted mb-0">
                    Stay organised, track your progress and achieve
                    your academic goals with LearnTrack.
                </p>
            </div>
        </div>
    </section>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const courseTitles = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(ViewBag.CourseTitles)
        );

        const courseProgress = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(ViewBag.CourseProgress)
        );

        const chartCanvas = document.getElementById('courseProgressChart');

        if (chartCanvas && typeof Chart !== 'undefined') {
            const context = chartCanvas.getContext('2d');

            const gradient = context.createLinearGradient(0, 0, 0, 330);
            gradient.addColorStop(0, 'rgba(37, 99, 235, 0.85)');
            gradient.addColorStop(1, 'rgba(37, 99, 235, 0.18)');

            new Chart(chartCanvas, {
                type: 'bar',

                data: {
                    labels: courseTitles,

                    datasets: [{
                        label: 'Course Completion (%)',
                        data: courseProgress,
                        backgroundColor: gradient,
                        borderColor: '#2563EB',
                        borderWidth: 1,
                        borderRadius: 12,
                        maxBarThickness: 65
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,

                            ticks: {
                                stepSize: 20,
                                callback: function(value) {
                                    return value + '%';
                                }
                            },

                            grid: {
                                color: 'rgba(23, 37, 84, 0.07)'
                            }
                        },

                        x: {
                            grid: {
                                display: false
                            }
                        }
                    },

                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        }
                    }
                }
            });
        }
    </script>
}
```