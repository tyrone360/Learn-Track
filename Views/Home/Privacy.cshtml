 
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="text-center mb-5">
        <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-3 py-2 mb-3">
            <i class="bi bi-shield-check me-1"></i>
            YOUR PRIVACY MATTERS
        </span>

        <h1 class="display-5 fw-bold mb-3">Privacy Policy</h1>

        <p class="text-muted mx-auto" style="max-width: 700px;">
            LearnTrack respects your privacy. This policy explains what
            information may be collected when you use our platform and
            how that information is handled.
        </p>

        <small class="text-muted">
            Last updated: @DateTime.Today.ToString("dd MMMM yyyy")
        </small>
    </div>

    <!-- Policy Content -->
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 p-md-5">

                    <!-- Introduction -->
                    <section class="mb-5">
                        <h4 class="fw-bold mb-3">
                            <i class="bi bi-info-circle text-primary me-2"></i>
                            1. Introduction
                        </h4>
                        <p class="text-muted">
                            LearnTrack is a learning management platform designed
                            to help users organise courses, manage study goals
                            and monitor learning progress. This Privacy Policy
                            explains how information associated with your account
                            and use of the platform may be collected, used and
                            managed.
                        </p>
                    </section>

                    <hr class="my-4">

                    <!-- Information Collected -->
                    <section class="mb-5">
                        <h4 class="fw-bold mb-3">
                            <i class="bi bi-person-lines-fill text-primary me-2"></i>
                            2. Information We Collect
                        </h4>
                        <p class="text-muted">
                            Depending on how you use LearnTrack, the platform
                            may process the following information:
                        </p>
                        <ul class="text-muted">
                            <li>Account information, such as your name and email address.</li>
                            <li>Organisation information supplied during registration, if applicable.</li>
                            <li>Course information that you create or manage.</li>
                            <li>Study goals, descriptions and target dates.</li>
                            <li>Learning progress and completion information.</li>
                        </ul>
                    </section>

                    <hr class="my-4">

                    <!-- Use of Information -->
                    <section class="mb-5">
                        <h4 class="fw-bold mb-3">
                            <i class="bi bi-gear text-primary me-2"></i>
                            3. How We Use Your Information
                        </h4>
                        <p class="text-muted">
                            Information processed by LearnTrack is used to
                            support the platform's learning and account
                            management features. This may include:
                        </p>
                        <ul class="text-muted">
                            <li>Creating and managing user accounts.</li>
                            <li>Allowing users to manage their courses and study goals.</li>
                            <li>Displaying learning progress and dashboard statistics.</li>
                            <li>Supporting account authentication and platform security.</li>
                            <li>Maintaining and improving the functionality of LearnTrack.</li>
                        </ul>
                    </section>

                    <hr class="my-4">

                    <!-- Data Storage -->
                    <section class="mb-5">
                        <h4 class="fw-bold mb-3">
                            <i class="bi bi-database text-primary me-2"></i>
                            4. Data Storage and Security
                        </h4>
                        <p class="text-muted">
                            Information submitted through LearnTrack is handled
                            using the application's configured data storage
                            system. Appropriate security measures should be
                            maintained to help protect account information and
                            prevent unauthorised access.
                        </p>
                        <p class="text-muted mb-0">
                            Users should keep their login credentials private
                            and notify the platform administrator if they
                            become aware of suspicious account activity.
                        </p>
                    </section>

                    <hr class="my-4">

                    <!-- Sharing -->
                    <section class="mb-5">
                        <h4 class="fw-bold mb-3">
                            <i class="bi bi-share text-primary me-2"></i>
                            5. Sharing of Information
                        </h4>
                        <p class="text-muted mb-0">
                            Personal information should only be accessed or
                            shared where necessary to operate the platform,
                            provide requested services, meet applicable legal
                            requirements or protect the rights and security
                            of users. Any third-party services used by the
                            deployed application should be covered by their
                            own applicable privacy terms.
                        </p>
                    </section>

                    <hr class="my-4">

                    <!-- Cookies -->
                    <section class="mb-5">
                        <h4 class="fw-bold mb-3">
                            <i class="bi bi-cookie text-primary me-2"></i>
                            6. Cookies and Authentication
                        </h4>
                        <p class="text-muted mb-0">
                            LearnTrack may use essential cookies or similar
                            technologies to support sign-in, authentication
                            and basic website functionality. Your browser
                            settings may allow you to manage cookies, although
                            disabling essential cookies may affect some
                            platform features.
                        </p>
                    </section>

                    <hr class="my-4">

                    <!-- User Rights -->
                    <section class="mb-5">
                        <h4 class="fw-bold mb-3">
                            <i class="bi bi-person-check text-primary me-2"></i>
                            7. Your Privacy Rights
                        </h4>
                        <p class="text-muted">
                            Subject to applicable privacy laws, including
                            South Africa's Protection of Personal Information
                            Act (POPIA), users may have the right to:
                        </p>
                        <ul class="text-muted">
                            <li>Request access to their personal information.</li>
                            <li>Request correction of inaccurate information.</li>
                            <li>Request deletion of information where legally permitted.</li>
                            <li>Raise concerns about how their information is handled.</li>
                        </ul>
                    </section>

                    <hr class="my-4">

                    <!-- Changes -->
                    <section class="mb-5">
                        <h4 class="fw-bold mb-3">
                            <i class="bi bi-arrow-repeat text-primary me-2"></i>
                            8. Changes to This Policy
                        </h4>
                        <p class="text-muted mb-0">
                            This Privacy Policy may be updated when LearnTrack's
                            features, data practices or applicable requirements
                            change. Users should review this page periodically
                            to stay informed about how their information is handled.
                        </p>
                    </section>

                    <hr class="my-4">

                    <!-- Contact -->
                    <section>
                        <h4 class="fw-bold mb-3">
                            <i class="bi bi-envelope text-primary me-2"></i>
                            9. Contact and Privacy Questions
                        </h4>
                        <p class="text-muted mb-0">
                            If you have questions, concerns or requests relating
                            to this Privacy Policy or your personal information,
                            please contact the LearnTrack administrator through
                            the support or contact channel provided by the
                            organisation operating the platform.
                        </p>
                    </section>

                </div>
            </div>

            <!-- Closing Message -->
            <div class="p-4 rounded-4 text-white text-center shadow-sm"
                 style="background: linear-gradient(120deg, #172554, #2563EB);">

                <i class="bi bi-shield-lock fs-1 mb-3"></i>

                <h4 class="fw-bold">Your Learning. Your Information.</h4>

                <p class="text-white-50 mb-3">
                    Thank you for using LearnTrack to organise and manage
                    your learning journey.
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-light rounded-3 px-4 fw-semibold">
                    <i class="bi bi-house me-2"></i>
                    Back to Home
                </a>
            </div>

        </div>
    </div>
</div>