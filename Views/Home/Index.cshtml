
@{
    ViewData["Title"] = "LearnTrack";
}

<style>
    .home-page {
        color: #172554;
    }

    /* HERO SLIDESHOW */
    .hero-slider {
        position: relative;
        min-height: 570px;
        overflow: hidden;
        border-radius: 32px;
        isolation: isolate;
        box-shadow: 0 25px 65px rgba(23, 37, 84, 0.16);
    }

    .hero-slider .carousel,
    .hero-slider .carousel-inner,
    .hero-slider .carousel-item {
        height: 570px;
    }

    .hero-slider .carousel-item {
        position: relative;
        background-size: cover;
        background-position: center;
    }

    .hero-slider .carousel-item::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            90deg,
            rgba(15, 23, 42, 0.88) 0%,
            rgba(23, 37, 84, 0.65) 55%,
            rgba(23, 37, 84, 0.15) 100%
        );
    }

    .slide-one {
        background-image: url("https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1800&q=85");
    }

    .slide-two {
        background-image: url("https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1800&q=85");
    }

    .slide-three {
        background-image: url("https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&w=1800&q=85");
    }

    .hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        height: 100%;
        padding: 65px;
        color: white;
    }

    .hero-copy {
        max-width: 690px;
    }

    .hero-label {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 10px 17px;
        margin-bottom: 25px;
        border: 1px solid rgba(255,255,255,0.35);
        border-radius: 50px;
        background: rgba(255,255,255,0.16);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        color: white;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 1.2px;
    }

    .hero-copy h1 {
        font-size: clamp(2.8rem, 6vw, 5rem);
        line-height: 1.05;
        font-weight: 800;
        letter-spacing: -2.5px;
        margin-bottom: 22px;
    }

    .hero-copy p {
        max-width: 600px;
        color: rgba(255,255,255,0.86);
        font-size: 1.13rem;
        line-height: 1.8;
        margin-bottom: 30px;
    }

    .hero-primary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 25px;
        border-radius: 16px;
        background: white;
        color: #1d4ed8;
        font-weight: 800;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .hero-primary-btn:hover {
        background: #eff6ff;
        color: #172554;
        transform: translateY(-3px);
    }

    .hero-secondary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 13px 24px;
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.65);
        background: rgba(255,255,255,0.12);
        backdrop-filter: blur(12px);
        color: white;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .hero-secondary-btn:hover {
        background: rgba(255,255,255,0.25);
        color: white;
        transform: translateY(-3px);
    }

    .hero-glass-card {
        position: absolute;
        z-index: 3;
        right: 55px;
        bottom: 55px;
        width: 245px;
        padding: 23px;
        color: white;
        border: 1px solid rgba(255,255,255,0.4);
        border-radius: 23px;
        background: rgba(255,255,255,0.16);
        backdrop-filter: blur(22px);
        -webkit-backdrop-filter: blur(22px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.12);
    }

    .hero-glass-card i {
        font-size: 30px;
    }

    .hero-glass-card h5 {
        margin-top: 12px;
        font-weight: 800;
    }

    .hero-glass-card p {
        margin-bottom: 0;
        font-size: 0.85rem;
        color: rgba(255,255,255,0.82);
    }

    .hero-slider .carousel-indicators {
        z-index: 5;
        margin-bottom: 25px;
        justify-content: flex-start;
        margin-left: 65px;
    }

    .hero-slider .carousel-indicators button {
        width: 28px;
        height: 5px;
        border: 0;
        border-radius: 10px;
    }

    .hero-slider .carousel-control-prev,
    .hero-slider .carousel-control-next {
        z-index: 4;
        width: 7%;
    }

    /* INTRODUCTION */
    .section-eyebrow {
        color: #2563eb;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 1.5px;
    }

    .section-heading {
        color: #172554;
        font-weight: 800;
        letter-spacing: -1px;
    }

    /* GLASS FEATURE CARDS */
    .glass-feature-card {
        position: relative;
        height: 100%;
        overflow: hidden;
        padding: 35px 30px;
        border: 1px solid rgba(255,255,255,0.95);
        border-radius: 26px;
        background: rgba(255,255,255,0.66);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        box-shadow: 0 12px 35px rgba(23,37,84,0.07);
        transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

    .glass-feature-card::before {
        content: "";
        position: absolute;
        top: -65px;
        right: -65px;
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: rgba(59,130,246,0.07);
    }

    .glass-feature-card:hover {
        transform: translateY(-9px);
        box-shadow: 0 22px 45px rgba(23,37,84,0.12);
    }

    .feature-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 68px;
        height: 68px;
        margin-bottom: 25px;
        border: 1px solid rgba(37,99,235,0.12);
        border-radius: 21px;
        background: rgba(219,234,254,0.65);
        color: #2563eb;
        font-size: 30px;
        backdrop-filter: blur(10px);
    }

    .glass-feature-card h4 {
        font-weight: 800;
        margin-bottom: 13px;
    }

    .glass-feature-card p {
        color: #64748b;
        line-height: 1.8;
        margin-bottom: 0;
    }

    /* GLASS INFORMATION STRIP */
    .glass-info-strip {
        padding: 30px;
        border: 1px solid rgba(255,255,255,0.9);
        border-radius: 25px;
        background: rgba(255,255,255,0.63);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 12px 35px rgba(23,37,84,0.06);
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .info-item i {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        border-radius: 16px;
        background: rgba(219,234,254,0.8);
        color: #2563eb;
        font-size: 22px;
    }

    .info-item strong {
        display: block;
        color: #172554;
    }

    .info-item span {
        color: #64748b;
        font-size: 0.85rem;
    }

    /* CALL TO ACTION */
    .glass-cta {
        position: relative;
        overflow: hidden;
        padding: 65px 25px;
        border: 1px solid rgba(255,255,255,0.8);
        border-radius: 30px;
        background: linear-gradient(
            135deg,
            rgba(219,234,254,0.78),
            rgba(255,255,255,0.8)
        );
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        box-shadow: 0 15px 40px rgba(23,37,84,0.07);
    }

    .glass-cta h2 {
        font-weight: 800;
        letter-spacing: -1px;
    }

    .cta-button {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 25px;
        border-radius: 15px;
        background: linear-gradient(135deg, #172554, #2563eb);
        color: white;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 8px 22px rgba(37,99,235,0.2);
        transition: all 0.3s ease;
    }

    .cta-button:hover {
        color: white;
        transform: translateY(-3px);
        box-shadow: 0 12px 28px rgba(37,99,235,0.3);
    }

    /* RESPONSIVE */
    @@media (max-width: 767.98px) {
        .hero-slider {
            min-height: 650px;
            border-radius: 23px;
        }

        .hero-slider .carousel,
        .hero-slider .carousel-inner,
        .hero-slider .carousel-item {
            height: 650px;
        }

        .hero-content {
            align-items: flex-start;
            padding: 55px 25px;
        }

        .hero-copy h1 {
            letter-spacing: -1.5px;
        }

        .hero-copy p {
            font-size: 1rem;
        }

        .hero-glass-card {
            right: 20px;
            bottom: 55px;
            width: 205px;
            padding: 17px;
        }

        .hero-slider .carousel-indicators {
            margin-left: 25px;
        }

        .glass-feature-card {
            padding: 28px 24px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .glass-feature-card,
        .hero-primary-btn,
        .hero-secondary-btn,
        .cta-button {
            transition: none;
        }
    }
</style>

<div class="home-page">

    <!-- HERO SLIDESHOW -->
    <section class="container-fluid px-0 px-md-2 py-3">

        <div id="learnTrackSlideshow"
             class="hero-slider carousel slide carousel-fade"
             data-bs-ride="carousel"
             data-bs-interval="5500"
             data-bs-pause="hover">

            <div class="carousel-indicators">
                <button type="button"
                        data-bs-target="#learnTrackSlideshow"
                        data-bs-slide-to="0"
                        class="active"
                        aria-current="true"
                        aria-label="Slide 1"></button>

                <button type="button"
                        data-bs-target="#learnTrackSlideshow"
                        data-bs-slide-to="1"
                        aria-label="Slide 2"></button>

                <button type="button"
                        data-bs-target="#learnTrackSlideshow"
                        data-bs-slide-to="2"
                        aria-label="Slide 3"></button>
            </div>

            <div class="carousel-inner">

                <!-- SLIDE 1 -->
                <div class="carousel-item active slide-one">

                    <div class="hero-content">
                        <div class="hero-copy">

                            <span class="hero-label">
                                <i class="bi bi-stars"></i>
                                YOUR PERSONAL LEARNING PLATFORM
                            </span>

                            <h1>
                                Welcome to<br />
                                LearnTrack.
                            </h1>

                            <p>
                                Take control of your education. Organise your
                                courses, monitor your progress and achieve
                                your academic goals in one place.
                            </p>

                            <div class="d-flex flex-wrap gap-3">

                                <a asp-controller="Account"
                                   asp-action="Register"
                                   class="hero-primary-btn">
                                    Get Started
                                    <i class="bi bi-arrow-right"></i>
                                </a>

                                <a asp-controller="Account"
                                   asp-action="Login"
                                   class="hero-secondary-btn">
                                    Sign In
                                </a>

                            </div>
                        </div>
                    </div>

                </div>

                <!-- SLIDE 2 -->
                <div class="carousel-item slide-two">

                    <div class="hero-content">
                        <div class="hero-copy">

                            <span class="hero-label">
                                <i class="bi bi-journal-bookmark"></i>
                                YOUR LEARNING, ORGANISED
                            </span>

                            <h1>
                                Make every<br />
                                lesson count.
                            </h1>

                            <p>
                                Keep your learning activities organised.
                                Manage your courses and create a study
                                routine that works for you.
                            </p>

                            <a asp-controller="Account"
                               asp-action="Register"
                               class="hero-primary-btn">
                                Start Learning
                                <i class="bi bi-arrow-right"></i>
                            </a>

                        </div>
                    </div>

                </div>

                <!-- SLIDE 3 -->
                <div class="carousel-item slide-three">

                    <div class="hero-content">
                        <div class="hero-copy">

                            <span class="hero-label">
                                <i class="bi bi-bullseye"></i>
                                SMALL STEPS. BIG ACHIEVEMENTS.
                            </span>

                            <h1>
                                Your goals.<br />
                                Your progress.
                            </h1>

                            <p>
                                Set meaningful study targets, monitor
                                your progress and celebrate every
                                milestone along your academic journey.
                            </p>

                            <a asp-controller="Account"
                               asp-action="Register"
                               class="hero-primary-btn">
                                Create Your Account
                                <i class="bi bi-arrow-right"></i>
                            </a>

                        </div>
                    </div>

                </div>

            </div>

            <button class="carousel-control-prev"
                    type="button"
                    data-bs-target="#learnTrackSlideshow"
                    data-bs-slide="prev"
                    aria-label="Previous slide">

                <span class="carousel-control-prev-icon"
                      aria-hidden="true"></span>
            </button>

            <button class="carousel-control-next"
                    type="button"
                    data-bs-target="#learnTrackSlideshow"
                    data-bs-slide="next"
                    aria-label="Next slide">

                <span class="carousel-control-next-icon"
                      aria-hidden="true"></span>
            </button>

            <!-- FLOATING GLASS CARD -->
            <div class="hero-glass-card d-none d-md-block">
                <i class="bi bi-mortarboard"></i>

                <h5>Learn. Track. Achieve.</h5>

                <p>
                    Your journey to better learning starts here.
                </p>
            </div>

        </div>

    </section>

    <!-- INTRODUCTION -->
    <section class="container py-5">

        <div class="text-center mb-5">

            <span class="section-eyebrow">
                THE LEARNTRACK EXPERIENCE
            </span>

            <h2 class="section-heading display-6 mt-2">
                Everything You Need to Succeed
            </h2>

            <p class="text-secondary mt-3">
                A simpler and smarter way to manage your learning journey.
            </p>

        </div>

        <div class="row g-4">

            <!-- COURSES -->
            <div class="col-md-4">

                <div class="glass-feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-book-half"></i>
                    </div>

                    <h4>Manage Courses</h4>

                    <p>
                        Organise your courses, keep learning activities
                        together and make it easier to stay focused
                        on your studies.
                    </p>

                </div>

            </div>

            <!-- PROGRESS -->
            <div class="col-md-4">

                <div class="glass-feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>

                    <h4>Track Progress</h4>

                    <p>
                        Monitor your course completion, understand
                        your performance and see how far you have
                        progressed.
                    </p>

                </div>

            </div>

            <!-- GOALS -->
            <div class="col-md-4">

                <div class="glass-feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-bullseye"></i>
                    </div>

                    <h4>Achieve Your Goals</h4>

                    <p>
                        Set personal study targets, manage deadlines
                        and celebrate your academic achievements
                        along the way.
                    </p>

                </div>

            </div>

        </div>

    </section>

    <!-- GLASS INFORMATION STRIP -->
    <section class="container py-4">

        <div class="glass-info-strip">

            <div class="row g-4">

                <div class="col-md-4">

                    <div class="info-item">
                        <i class="bi bi-layers"></i>

                        <div>
                            <strong>One Learning Space</strong>
                            <span>Keep your studies organised.</span>
                        </div>
                    </div>

                </div>

                <div class="col-md-4">

                    <div class="info-item">
                        <i class="bi bi-bar-chart-line"></i>

                        <div>
                            <strong>Visible Progress</strong>
                            <span>Understand your learning journey.</span>
                        </div>
                    </div>

                </div>

                <div class="col-md-4">

                    <div class="info-item">
                        <i class="bi bi-calendar-check"></i>

                        <div>
                            <strong>Clear Study Goals</strong>
                            <span>Stay focused on your targets.</span>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- CALL TO ACTION -->
    <section class="container py-5">

        <div class="glass-cta text-center">

            <div class="feature-icon mx-auto">
                <i class="bi bi-rocket-takeoff"></i>
            </div>

            <h2 class="mt-3">
                Ready to Transform Your Learning?
            </h2>

            <p class="text-secondary mt-3 mb-4">
                Join LearnTrack and start organising your academic
                journey today.
            </p>

            <a asp-controller="Account"
               asp-action="Register"
               class="cta-button">

                Create Your Free Account
                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </section>

</div>
```

