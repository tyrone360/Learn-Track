
@model IEnumerable<LearnTrack.Models.StudyGoal>

@{
    ViewData["Title"] = "My Study Goals";

    var goals = Model?.ToList() ?? new List<LearnTrack.Models.StudyGoal>();

    var totalGoals = goals.Count;
    var completedGoals = goals.Count(g => g.IsCompleted);
    var pendingGoals = totalGoals - completedGoals;

    var completionRate = totalGoals > 0
        ? (int)Math.Round((double)completedGoals / totalGoals * 100)
        : 0;
}

<style>
    .goals-page {
        color: #172554;
        padding-bottom: 35px;
    }

    .glass-panel {
        background: rgba(255, 255, 255, 0.78);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.9);
        border-radius: 24px;
        box-shadow: 0 12px 35px rgba(23, 37, 84, 0.07);
    }

    .goals-hero {
        position: relative;
        overflow: hidden;
        padding: 42px;
        border-radius: 28px;
        color: white;
        background: linear-gradient(120deg, #172554, #2563eb);
        box-shadow: 0 18px 40px rgba(37, 99, 235, 0.18);
    }

    .goals-hero::before,
    .goals-hero::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        pointer-events: none;
    }

    .goals-hero::before {
        width: 260px;
        height: 260px;
        right: 10%;
        top: -150px;
    }

    .goals-hero::after {
        width: 190px;
        height: 190px;
        right: -40px;
        bottom: -110px;
    }

    .hero-content {
        position: relative;
        z-index: 1;
    }

    .hero-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 15px;
        border-radius: 30px;
        color: white;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.2);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .hero-completion {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        width: 115px;
        height: 115px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.13);
        border: 1px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(12px);
    }

    .hero-completion strong {
        font-size: 1.8rem;
        line-height: 1.2;
    }

    .hero-completion small {
        color: rgba(255, 255, 255, 0.75);
    }

    .section-label {
        color: #2563eb;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 1.3px;
    }

    .section-description {
        color: #64748b;
    }

    .stat-card {
        height: 100%;
        padding: 26px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 18px 35px rgba(23, 37, 84, 0.11);
    }

    .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 55px;
        height: 55px;
        border-radius: 18px;
        font-size: 25px;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -1px;
        color: #172554;
    }

    .completion-panel {
        padding: 30px;
    }

    .completion-track {
        height: 13px;
        border-radius: 30px;
        overflow: hidden;
        background: #eaf0fb;
    }

    .completion-fill {
        height: 100%;
        border-radius: 30px;
        background: linear-gradient(90deg, #2563eb, #60a5fa);
        transition: width 0.8s ease;
    }

    .completion-fill.complete {
        background: linear-gradient(90deg, #059669, #34d399);
    }

    .goal-card {
        height: 100%;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .goal-card:hover {
        transform: translateY(-7px);
        box-shadow: 0 20px 40px rgba(23, 37, 84, 0.12);
    }

    .goal-card .card-body {
        padding: 27px;
    }

    .goal-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 55px;
        height: 55px;
        border-radius: 18px;
        background: rgba(37, 99, 235, 0.09);
        color: #2563eb;
        font-size: 25px;
    }

    .goal-title {
        color: #172554;
        font-weight: 800;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .goal-description {
        color: #64748b;
        font-size: 0.92rem;
        line-height: 1.7;
        overflow-wrap: anywhere;
    }

    .goal-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 8px 12px;
        border-radius: 30px;
        font-size: 0.72rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-completed {
        color: #047857;
        background: rgba(16, 185, 129, 0.12);
    }

    .status-pending {
        color: #92400e;
        background: rgba(245, 158, 11, 0.13);
    }

    .target-date {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 15px;
        border: 1px solid rgba(37, 99, 235, 0.08);
        border-radius: 17px;
        background: rgba(239, 246, 255, 0.8);
    }

    .date-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 45px;
        height: 45px;
        flex-shrink: 0;
        border-radius: 14px;
        background: white;
        color: #2563eb;
        font-size: 21px;
    }

    .goal-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
    }

    .goal-actions form {
        flex: 1;
    }

    .goal-actions .btn {
        width: 100%;
        border-radius: 12px;
        padding: 9px 12px;
        font-weight: 600;
        transition: transform 0.25s ease;
    }

    .goal-actions .btn:hover {
        transform: translateY(-2px);
    }

    .empty-state {
        padding: 65px 25px;
        text-align: center;
    }

    .empty-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100px;
        height: 100px;
        border-radius: 32px;
        background: rgba(37, 99, 235, 0.08);
        color: #2563eb;
        font-size: 48px;
    }

    .back-button {
        border-radius: 13px;
        padding: 11px 20px;
        font-weight: 600;
        transition: all 0.25s ease;
    }

    .back-button:hover {
        transform: translateX(-3px);
    }

    @@media (max-width: 767px) {
        .goals-hero {
            padding: 30px 24px;
        }

        .goals-hero h1 {
            font-size: 2rem;
        }

        .hero-completion {
            width: 90px;
            height: 90px;
        }

        .hero-completion strong {
            font-size: 1.4rem;
        }

        .stat-number {
            font-size: 1.7rem;
        }

        .completion-panel {
            padding: 24px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .stat-card,
        .goal-card,
        .goal-actions .btn,
        .back-button,
        .completion-fill {
            transition: none;
        }

        .stat-card:hover,
        .goal-card:hover,
        .back-button:hover {
            transform: none;
        }
    }
</style>

<div class="container py-5 goals-page">

    <!-- Hero Section -->
    <section class="goals-hero mb-5">

        <div class="row align-items-center">

            <div class="col-lg-8 hero-content">

                <span class="hero-label mb-3">
                    <i class="bi bi-bullseye"></i>
                    PERSONAL DEVELOPMENT
                </span>

                <h1 class="display-5 fw-bold mt-3 mb-3">
                    My Study Goals
                </h1>

                <p class="lead opacity-75 mb-4">
                    Set targets, stay focused and achieve your learning goals.
                </p>

                <a asp-controller="StudyGoals"
                   asp-action="Create"
                   class="btn btn-light text-primary fw-bold rounded-3 px-4 py-3">

                    <i class="bi bi-plus-lg me-2"></i>
                    Add New Goal

                </a>

            </div>

            <div class="col-lg-4 d-flex justify-content-lg-end justify-content-center mt-4 mt-lg-0 hero-content">

                <div class="hero-completion">

                    <strong>@completionRate%</strong>

                    <small>Completion</small>

                </div>

            </div>

        </div>

    </section>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4"
             role="alert">

            <i class="bi bi-exclamation-circle-fill me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- Statistics Heading -->
    <div class="mb-4">

        <span class="section-label">
            YOUR PERFORMANCE
        </span>

        <h3 class="fw-bold mt-2 mb-1">
            Goal Overview
        </h3>

        <p class="section-description mb-0">
            See what you have achieved and what still needs your attention.
        </p>

    </div>

    <!-- Statistics -->
    <div class="row g-4 mb-5">

        <div class="col-md-4">

            <div class="glass-panel stat-card">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <span class="text-muted fw-semibold">
                        Total Goals
                    </span>

                    <div class="stat-icon bg-primary bg-opacity-10">
                        <i class="bi bi-flag-fill text-primary"></i>
                    </div>

                </div>

                <div class="stat-number">@totalGoals</div>

                <small class="text-muted">
                    All your study targets
                </small>

            </div>

        </div>

        <div class="col-md-4">

            <div class="glass-panel stat-card">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <span class="text-muted fw-semibold">
                        Completed Goals
                    </span>

                    <div class="stat-icon bg-success bg-opacity-10">
                        <i class="bi bi-check-circle-fill text-success"></i>
                    </div>

                </div>

                <div class="stat-number text-success">@completedGoals</div>

                <small class="text-muted">
                    Successfully achieved
                </small>

            </div>

        </div>

        <div class="col-md-4">

            <div class="glass-panel stat-card">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <span class="text-muted fw-semibold">
                        Pending Goals
                    </span>

                    <div class="stat-icon bg-warning bg-opacity-10">
                        <i class="bi bi-clock-history text-warning"></i>
                    </div>

                </div>

                <div class="stat-number">@pendingGoals</div>

                <small class="text-muted">
                    Still to be completed
                </small>

            </div>

        </div>

    </div>

    <!-- Overall Completion -->
    <section class="glass-panel completion-panel mb-5">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

            <div>

                <span class="section-label">
                    YOUR ACHIEVEMENTS
                </span>

                <h5 class="fw-bold mt-2 mb-1">
                    Overall Goal Completion
                </h5>

                <p class="text-muted small mb-0">
                    Track your progress towards your study targets.
                </p>

            </div>

            <div class="text-primary fw-bold display-6">
                @completionRate%
            </div>

        </div>

        <div class="completion-track"
             role="progressbar"
             aria-label="Overall goal completion"
             aria-valuenow="@completionRate"
             aria-valuemin="0"
             aria-valuemax="100">

            <div class="completion-fill @(completionRate == 100 ? "complete" : "")"
                 style="width: @completionRate%;">
            </div>

        </div>

        <div class="d-flex justify-content-between flex-wrap gap-2 mt-3">

            <small class="text-muted">
                <i class="bi bi-check-circle-fill text-success me-1"></i>
                @completedGoals completed
            </small>

            <small class="text-muted">
                <i class="bi bi-clock-fill text-warning me-1"></i>
                @pendingGoals remaining
            </small>

        </div>

    </section>

    <!-- Goals Heading -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>

            <span class="section-label">
                PERSONAL TARGETS
            </span>

            <h3 class="fw-bold mt-2 mb-1">
                Your Goals
            </h3>

            <p class="section-description mb-0">
                Manage your learning targets and achievements.
            </p>

        </div>

        <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-3 py-2">
            @totalGoals @(totalGoals == 1 ? "Goal" : "Goals")
        </span>

    </div>

    <!-- Goals List -->
    @if (!goals.Any())
    {
        <div class="glass-panel empty-state">

            <div class="empty-icon mb-4">
                <i class="bi bi-bullseye"></i>
            </div>

            <h4 class="fw-bold">
                No Study Goals Yet
            </h4>

            <p class="text-muted mx-auto mb-4"
               style="max-width: 430px;">

                You haven't created any study goals yet.
                Start by setting your first learning target.

            </p>

            <a asp-controller="StudyGoals"
               asp-action="Create"
               class="btn btn-primary btn-lg rounded-3 px-4">

                <i class="bi bi-plus-lg me-2"></i>
                Create Your First Goal

            </a>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var goal in goals)
            {
                <div class="col-md-6">

                    <article class="glass-panel goal-card">

                        <div class="card-body d-flex flex-column">

                            <!-- Goal Header -->
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-4">

                                <div>

                                    <div class="goal-icon mb-3">
                                        <i class="bi bi-bookmark-star-fill"></i>
                                    </div>

                                    <h5 class="goal-title mb-1">
                                        @goal.Title
                                    </h5>

                                    <small class="text-muted">
                                        Study Goal #@goal.Id
                                    </small>

                                </div>

                                @if (goal.IsCompleted)
                                {
                                    <span class="goal-status status-completed">

                                        <i class="bi bi-check-circle-fill"></i>
                                        Completed

                                    </span>
                                }
                                else
                                {
                                    <span class="goal-status status-pending">

                                        <i class="bi bi-clock-fill"></i>
                                        Pending

                                    </span>
                                }

                            </div>

                            <!-- Description -->
                            <div class="flex-grow-1 mb-4">

                                <p class="goal-description mb-0">

                                    @(string.IsNullOrWhiteSpace(goal.Description)
                                        ? "No description provided."
                                        : goal.Description)

                                </p>

                            </div>

                            <!-- Target Date -->
                            <div class="target-date mb-4">

                                <div class="date-icon">
                                    <i class="bi bi-calendar-event"></i>
                                </div>

                                <div>

                                    <small class="text-muted d-block">
                                        Target Date
                                    </small>

                                    <strong class="text-dark">
                                        @goal.TargetDate.ToString("dd MMMM yyyy")
                                    </strong>

                                </div>

                            </div>

                            <!-- Actions -->
                            <div class="goal-actions pt-3 border-top">

                                <form asp-action="ToggleComplete"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@goal.Id" />

                                    @if (goal.IsCompleted)
                                    {
                                        <button type="submit"
                                                class="btn btn-outline-secondary btn-sm">

                                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                                            Mark as Pending

                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="btn btn-success btn-sm">

                                            <i class="bi bi-check-lg me-1"></i>
                                            Mark as Complete

                                        </button>
                                    }

                                </form>

                                <form asp-action="Delete"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this goal?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@goal.Id" />

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm">

                                        <i class="bi bi-trash me-1"></i>
                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>

                    </article>

                </div>
            }

        </div>
    }

    <!-- Back Navigation -->
    <div class="mt-5">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary back-button">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Dashboard

        </a>

    </div>

</div>
