
@model LearnTrack.Models.StudyGoal

@{
    ViewData["Title"] = "Create Study Goal";
}

<style>
    .goal-create-page {
        padding-top: 3rem;
        padding-bottom: 4rem;
        color: #172554;
    }

    .goal-create-header {
        margin-bottom: 2rem;
    }

    .goal-create-header .back-link {
        color: #64748b;
        text-decoration: none;
        font-weight: 600;
        transition: color .2s ease;
    }

    .goal-create-header .back-link:hover {
        color: #2563eb;
    }

    .goal-create-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 15px;
        border-radius: 50px;
        background: rgba(37, 99, 235, .09);
        color: #2563eb;
        font-size: .75rem;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .goal-create-header h1 {
        color: #172554;
        letter-spacing: -1px;
    }

    .goal-create-header p {
        color: #64748b;
        max-width: 600px;
    }

    .glass-form-card {
        background: rgba(255, 255, 255, .82);
        border: 1px solid rgba(255, 255, 255, .9);
        border-radius: 26px;
        overflow: hidden;
        box-shadow: 0 18px 55px rgba(23, 37, 84, .09);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

    .glass-form-header {
        padding: 2rem;
        color: white;
        background: linear-gradient(120deg, #172554, #2563eb);
        position: relative;
        overflow: hidden;
    }

    .glass-form-header::after {
        content: "";
        position: absolute;
        width: 190px;
        height: 190px;
        border-radius: 50%;
        background: rgba(255, 255, 255, .08);
        right: -55px;
        top: -85px;
    }

    .goal-header-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 19px;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .22);
        font-size: 2rem;
        flex-shrink: 0;
    }

    .glass-form-body {
        padding: 2.5rem;
    }

    .goal-form-label {
        display: block;
        margin-bottom: 10px;
        color: #172554;
        font-weight: 700;
    }

    .goal-input-group {
        display: flex;
        align-items: stretch;
        border: 1px solid #dbe4f0;
        border-radius: 15px;
        overflow: hidden;
        background: rgba(248, 250, 252, .85);
        transition: border-color .25s ease, box-shadow .25s ease;
    }

    .goal-input-group:focus-within {
        border-color: #60a5fa;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, .10);
    }

    .goal-input-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 55px;
        flex-shrink: 0;
        color: #2563eb;
        background: rgba(37, 99, 235, .06);
        font-size: 1.1rem;
    }

    .goal-input-group .form-control {
        min-height: 56px;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: #172554;
        box-shadow: none;
        padding: 13px 16px;
    }

    .goal-input-group .form-control:focus {
        background: transparent;
        box-shadow: none;
    }

    .goal-textarea {
        min-height: 145px;
        resize: vertical;
        border: 1px solid #dbe4f0;
        border-radius: 15px;
        background: rgba(248, 250, 252, .85);
        color: #172554;
        padding: 16px;
        transition: border-color .25s ease, box-shadow .25s ease;
    }

    .goal-textarea:focus {
        border-color: #60a5fa;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, .10);
        background: white;
    }

    .goal-input-group input::placeholder,
    .goal-textarea::placeholder {
        color: #94a3b8;
    }

    .goal-form-help {
        color: #94a3b8;
        font-size: .83rem;
    }

    .goal-validation {
        display: block;
        margin-top: 7px;
    }

    .goal-submit-btn {
        border: 0;
        border-radius: 14px;
        padding: 14px 22px;
        color: white;
        font-weight: 700;
        background: linear-gradient(120deg, #172554, #2563eb);
        box-shadow: 0 8px 20px rgba(37, 99, 235, .2);
        transition: transform .25s ease, box-shadow .25s ease;
    }

    .goal-submit-btn:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(37, 99, 235, .3);
    }

    .goal-cancel-btn {
        border: 1px solid #dbe4f0;
        border-radius: 14px;
        padding: 14px 22px;
        color: #475569;
        background: rgba(255, 255, 255, .8);
        font-weight: 700;
        transition: all .25s ease;
    }

    .goal-cancel-btn:hover {
        color: #172554;
        background: #f1f5f9;
        border-color: #cbd5e1;
    }

    .goal-tip-card {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        margin-top: 1.5rem;
        padding: 22px;
        border-radius: 20px;
        background: rgba(239, 246, 255, .85);
        border: 1px solid rgba(147, 197, 253, .35);
    }

    .goal-tip-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 15px;
        color: #2563eb;
        background: white;
        font-size: 1.4rem;
        box-shadow: 0 5px 15px rgba(37, 99, 235, .08);
    }

    .goal-tip-card h6 {
        color: #172554;
    }

    .goal-tip-card p {
        color: #64748b;
        line-height: 1.7;
    }

    .validation-summary-valid {
        display: none;
    }

    @@media (max-width: 576px) {
        .goal-create-page {
            padding-top: 1.5rem;
        }

        .glass-form-header {
            padding: 1.5rem;
        }

        .glass-form-body {
            padding: 1.5rem;
        }

        .goal-header-icon {
            width: 54px;
            height: 54px;
            font-size: 1.6rem;
        }

        .goal-create-header h1 {
            font-size: 1.8rem;
        }

        .goal-tip-card {
            padding: 17px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .goal-create-page *,
        .goal-create-page *::before,
        .goal-create-page *::after {
            transition: none !important;
        }
    }
</style>

<div class="container goal-create-page">

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <!-- Page Header -->
            <div class="goal-create-header">

                <a asp-controller="StudyGoals"
                   asp-action="Index"
                   class="back-link small">
                    <i class="bi bi-arrow-left me-2"></i>
                    Back to Study Goals
                </a>

                <div class="mt-4">

                    <span class="goal-create-badge mb-3">
                        <i class="bi bi-bullseye"></i>
                        PERSONAL DEVELOPMENT
                    </span>

                    <h1 class="fw-bold mt-2 mb-2">
                        Create a Study Goal
                    </h1>

                    <p class="mb-0">
                        Set a learning target and take another step towards
                        achieving your academic goals.
                    </p>

                </div>
            </div>

            <!-- Glass Form Card -->
            <div class="glass-form-card">

                <!-- Form Header -->
                <div class="glass-form-header">

                    <div class="d-flex align-items-center gap-3 position-relative"
                         style="z-index: 1;">

                        <div class="goal-header-icon">
                            <i class="bi bi-bullseye"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                Goal Information
                            </h5>

                            <p class="small text-white-50 mb-0">
                                Complete the details below to create your study goal.
                            </p>
                        </div>

                    </div>
                </div>

                <!-- Form Body -->
                <div class="glass-form-body">

                    <form asp-controller="StudyGoals"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger rounded-3"
                             role="alert"></div>

                        <!-- Goal Title -->
                        <div class="mb-4">

                            <label asp-for="Title"
                                   class="goal-form-label">
                                <i class="bi bi-flag me-1 text-primary"></i>
                                Goal Title
                            </label>

                            <div class="goal-input-group">

                                <span class="goal-input-icon">
                                    <i class="bi bi-bookmark-star"></i>
                                </span>

                                <input asp-for="Title"
                                       class="form-control"
                                       placeholder="e.g. Complete my Web Development course" />

                            </div>

                            <span asp-validation-for="Title"
                                  class="text-danger small goal-validation"></span>

                        </div>

                        <!-- Description -->
                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="goal-form-label">
                                <i class="bi bi-card-text me-1 text-primary"></i>
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control goal-textarea"
                                      rows="5"
                                      placeholder="Describe what you want to achieve..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small goal-validation"></span>

                            <div class="goal-form-help mt-2">
                                <i class="bi bi-info-circle me-1"></i>
                                Explain what you want to accomplish.
                            </div>

                        </div>

                        <!-- Target Date -->
                        <div class="mb-4">

                            <label asp-for="TargetDate"
                                   class="goal-form-label">
                                <i class="bi bi-calendar-event me-1 text-primary"></i>
                                Target Date
                            </label>

                            <div class="goal-input-group">

                                <span class="goal-input-icon">
                                    <i class="bi bi-calendar3"></i>
                                </span>

                                <input asp-for="TargetDate"
                                       type="date"
                                       class="form-control"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                            </div>

                            <span asp-validation-for="TargetDate"
                                  class="text-danger small goal-validation"></span>

                            <div class="goal-form-help mt-2">
                                <i class="bi bi-info-circle me-1"></i>
                                Choose the date by which you want to complete this goal.
                            </div>

                        </div>

                        <hr class="my-4" style="border-color: #e2e8f0;">

                        <!-- Action Buttons -->
                        <div class="d-flex flex-column flex-sm-row gap-3">

                            <button type="submit"
                                    class="btn goal-submit-btn flex-grow-1">

                                <i class="bi bi-check-circle me-2"></i>
                                Save Study Goal

                            </button>

                            <a asp-controller="StudyGoals"
                               asp-action="Index"
                               class="btn goal-cancel-btn">

                                <i class="bi bi-x-circle me-2"></i>
                                Cancel

                            </a>

                        </div>

                    </form>

                </div>
            </div>

            <!-- Study Tip -->
            <div class="goal-tip-card">

                <div class="goal-tip-icon">
                    <i class="bi bi-lightbulb-fill"></i>
                </div>

                <div>

                    <h6 class="fw-bold mb-1">
                        Study Tip
                    </h6>

                    <p class="small mb-0">
                        Break large learning targets into smaller goals.
                        Setting realistic deadlines can help you stay
                        organised and track your progress.
                    </p>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
