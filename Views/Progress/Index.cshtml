
@model IEnumerable<LearnTrack.Models.Course>

@{
    ViewData["Title"] = "My Progress";

    var courses = Model.ToList();
    var totalCourses = (int)ViewBag.TotalCourses;
    var averageProgress = Math.Clamp((int)ViewBag.AverageProgress, 0, 100);
    var completedCourses = courses.Count(c => c.ProgressPercentage == 100);
    var inProgressCourses = courses.Count(c => c.ProgressPercentage > 0 && c.ProgressPercentage < 100);
    var notStartedCourses = courses.Count(c => c.ProgressPercentage == 0);
}

<style>
    .progress-page {
        color: #172554;
    }

    .progress-glass {
        background: rgba(255, 255, 255, 0.74);
        border: 1px solid rgba(255, 255, 255, 0.9);
        border-radius: 25px;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        box-shadow: 0 12px 38px rgba(23, 37, 84, 0.07);
    }

    .progress-hero {
        padding: 35px;
        border-radius: 28px;
        color: white;
        background: linear-gradient(120deg, #172554, #2563EB);
        box-shadow: 0 18px 45px rgba(37, 99, 235, 0.16);
    }

    .progress-hero-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.17);
        border: 1px solid rgba(255, 255, 255, 0.25);
        font-size: 1.8rem;
        backdrop-filter: blur(12px);
    }

    .progress-label {
        color: #2563EB;
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 1.4px;
    }

    .progress-heading {
        color: #172554;
        font-weight: 800;
    }

    .stat-glass {
        height: 100%;
        padding: 25px;
        border-radius: 23px;
        background: rgba(255, 255, 255, 0.76);
        border: 1px solid rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 10px 32px rgba(23, 37, 84, 0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .stat-glass:hover,
    .course-glass:hover {
        transform: translateY(-5px);
        box-shadow: 0 17px 38px rgba(37, 99, 235, 0.11);
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: rgba(37, 99, 235, 0.10);
        color: #2563EB;
        font-size: 1.35rem;
    }

    .stat-number {
        color: #172554;
        font-size: 2.15rem;
        font-weight: 800;
        letter-spacing: -1px;
    }

    .course-glass {
        padding: 28px;
        margin-bottom: 22px;
        border-radius: 25px;
        background: rgba(255, 255, 255, 0.78);
        border: 1px solid rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        box-shadow: 0 12px 35px rgba(23, 37, 84, 0.06);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .course-icon {
        width: 53px;
        height: 53px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        color: #2563EB;
        background: rgba(37, 99, 235, 0.10);
        font-size: 1.4rem;
    }

    .course-progress-track {
        height: 13px;
        overflow: hidden;
        border-radius: 50px;
        background: #e9eefb;
    }

    .course-progress-fill {
        height: 100%;
        border-radius: 50px;
        transition: width 0.8s ease;
        background: linear-gradient(90deg, #2563EB, #60A5FA);
    }

    .course-progress-fill.completed {
        background: linear-gradient(90deg, #198754, #52c98a);
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 13px;
        border-radius: 50px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .status-completed {
        color: #146c43;
        background: rgba(25, 135, 84, 0.11);
    }

    .status-progress {
        color: #1d4ed8;
        background: rgba(37, 99, 235, 0.10);
    }

    .status-pending {
        color: #64748b;
        background: rgba(100, 116, 139, 0.12);
    }

    .status-summary-item {
        padding: 17px;
        border-radius: 17px;
        background: rgba(37, 99, 235, 0.045);
    }

    .form-control {
        border-radius: 13px;
        border-color: #dce5f5;
        padding: 12px 15px;
    }

    .form-control:focus {
        border-color: #60A5FA;
        box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.12);
    }

    .input-group-text {
        border-color: #dce5f5;
        border-radius: 0 13px 13px 0;
        background: #f3f6fc;
    }

    .glass-button {
        border-radius: 13px;
        padding: 11px 18px;
        font-weight: 600;
    }

    .empty-state {
        padding: 55px 25px;
    }

    @@media (max-width: 767.98px) {
        .progress-hero {
            padding: 26px 22px;
            border-radius: 23px;
        }

        .stat-number {
            font-size: 1.85rem;
        }

        .course-glass {
            padding: 21px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .stat-glass,
        .course-glass,
        .course-progress-fill {
            transition: none;
        }

        .stat-glass:hover,
        .course-glass:hover {
            transform: none;
        }
    }
</style>

<div class="container py-5 progress-page">

    <!-- Header -->
    <section class="progress-hero mb-5">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-4">

            <div class="d-flex align-items-center gap-3">
                <div class="progress-hero-icon">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>

                <div>
                    <span class="small fw-bold opacity-75">
                        YOUR LEARNING JOURNEY
                    </span>

                    <h1 class="fw-bold mb-2">
                        My Learning Progress
                    </h1>

                    <p class="mb-0 opacity-75">
                        Track your achievements and keep moving towards your goals.
                    </p>
                </div>
            </div>

            <a asp-controller="Courses"
               asp-action="Index"
               class="btn btn-light text-primary fw-semibold glass-button">
                <i class="bi bi-book me-2"></i>
                Manage Courses
            </a>

        </div>
    </section>

    <!-- Feedback Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm"
             role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm"
             role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- Overview Heading -->
    <div class="mb-4">
        <span class="progress-label">YOUR PERFORMANCE</span>
        <h3 class="progress-heading mt-1 mb-1">Progress Overview</h3>
        <p class="text-muted mb-0">
            See how far you have come in your learning journey.
        </p>
    </div>

    <!-- Overview Cards -->
    <div class="row g-4 mb-5">

        <!-- Total Courses -->
        <div class="col-md-4">
            <div class="stat-glass">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="text-muted fw-semibold">Total Courses</span>
                    <div class="stat-icon">
                        <i class="bi bi-book-fill"></i>
                    </div>
                </div>

                <div class="stat-number mb-2">@totalCourses</div>

                <small class="text-muted">
                    Courses in your learning journey
                </small>
            </div>
        </div>

        <!-- Overall Progress -->
        <div class="col-md-4">
            <div class="stat-glass">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="text-muted fw-semibold">Overall Progress</span>
                    <div class="stat-icon text-success"
                         style="background: rgba(25, 135, 84, 0.10);">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>

                <div class="stat-number mb-2">@averageProgress%</div>

                <div class="course-progress-track mt-3">
                    <div class="course-progress-fill completed"
                         role="progressbar"
                         style="width: @averageProgress%"
                         aria-valuenow="@averageProgress"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>
                </div>
            </div>
        </div>

        <!-- Completed Courses -->
        <div class="col-md-4">
            <div class="stat-glass">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="text-muted fw-semibold">Completed Courses</span>
                    <div class="stat-icon text-warning"
                         style="background: rgba(255, 193, 7, 0.13);">
                        <i class="bi bi-trophy-fill"></i>
                    </div>
                </div>

                <div class="stat-number text-success mb-2">
                    @completedCourses
                </div>

                <small class="text-muted">
                    Courses completed successfully
                </small>
            </div>
        </div>

    </div>

    <!-- Course Status Summary -->
    <section class="progress-glass p-4 mb-5">

        <div class="d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-pie-chart-fill text-primary fs-4"></i>
            <h5 class="progress-heading mb-0">Course Status Overview</h5>
        </div>

        <div class="row g-3">

            <div class="col-md-4">
                <div class="status-summary-item d-flex align-items-center gap-2">
                    <span class="status-pill status-completed">
                        <i class="bi bi-check-circle-fill"></i>
                    </span>

                    <span class="text-muted">Completed</span>
                    <strong class="ms-auto">@completedCourses</strong>
                </div>
            </div>

            <div class="col-md-4">
                <div class="status-summary-item d-flex align-items-center gap-2">
                    <span class="status-pill status-progress">
                        <i class="bi bi-hourglass-split"></i>
                    </span>

                    <span class="text-muted">In Progress</span>
                    <strong class="ms-auto">@inProgressCourses</strong>
                </div>
            </div>

            <div class="col-md-4">
                <div class="status-summary-item d-flex align-items-center gap-2">
                    <span class="status-pill status-pending">
                        <i class="bi bi-circle"></i>
                    </span>

                    <span class="text-muted">Not Started</span>
                    <strong class="ms-auto">@notStartedCourses</strong>
                </div>
            </div>

        </div>
    </section>

    <!-- Individual Course Progress -->
    <div class="mb-4">
        <span class="progress-label">KEEP MOVING FORWARD</span>
        <h3 class="progress-heading mt-1 mb-1">Course Progress</h3>
        <p class="text-muted mb-0">
            Update and monitor your individual course completion.
        </p>
    </div>

    @if (!courses.Any())
    {
        <section class="progress-glass empty-state text-center">
            <div class="stat-icon mx-auto mb-4"
                 style="width: 85px; height: 85px; font-size: 2.2rem;">
                <i class="bi bi-journal-plus"></i>
            </div>

            <h4 class="progress-heading">No courses available</h4>

            <p class="text-muted mb-4">
                Add your first course before tracking your progress.
            </p>

            <a asp-controller="Courses"
               asp-action="Create"
               class="btn btn-primary glass-button px-4">
                <i class="bi bi-plus-lg me-2"></i>
                Add Your First Course
            </a>
        </section>
    }
    else
    {
        @foreach (var course in courses)
        {
            var progress = Math.Clamp(course.ProgressPercentage, 0, 100);

            <section class="course-glass">

                <!-- Course Heading -->
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

                    <div class="d-flex align-items-center gap-3">
                        <div class="course-icon">
                            <i class="bi bi-journal-bookmark-fill"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">@course.Title</h5>

                            <span class="text-muted small">
                                <i class="bi bi-tag me-1"></i>
                                @(course.Category ?? "General")
                            </span>
                        </div>
                    </div>

                    <div class="text-md-end">
                        <h3 class="fw-bold mb-2">@progress%</h3>

                        @if (progress == 100)
                        {
                            <span class="status-pill status-completed">
                                <i class="bi bi-check-circle-fill"></i>
                                Completed
                            </span>
                        }
                        else if (progress > 0)
                        {
                            <span class="status-pill status-progress">
                                <i class="bi bi-hourglass-split"></i>
                                In Progress
                            </span>
                        }
                        else
                        {
                            <span class="status-pill status-pending">
                                <i class="bi bi-circle"></i>
                                Not Started
                            </span>
                        }
                    </div>

                </div>

                <!-- Progress Bar -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-semibold text-muted">
                        Course Completion
                    </span>

                    <span class="small fw-semibold text-muted">
                        @progress% of 100%
                    </span>
                </div>

                <div class="course-progress-track mb-4">
                    <div class="course-progress-fill @(progress == 100 ? "completed" : "")"
                         role="progressbar"
                         style="width: @progress%"
                         aria-valuenow="@progress"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>
                </div>

                <hr class="my-4 opacity-25" />

                <!-- Update Progress Form -->
                <form asp-controller="Progress"
                      asp-action="Update"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@course.Id" />

                    <label class="form-label fw-semibold"
                           for="progress-@course.Id">
                        <i class="bi bi-sliders me-2 text-primary"></i>
                        Update Completion Percentage
                    </label>

                    <div class="row g-3 align-items-end">

                        <div class="col-md-8">
                            <div class="input-group">
                                <input type="number"
                                       id="progress-@course.Id"
                                       name="progressPercentage"
                                       class="form-control"
                                       min="0"
                                       max="100"
                                       value="@course.ProgressPercentage"
                                       required />

                                <span class="input-group-text">%</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <button type="submit"
                                    class="btn btn-primary glass-button w-100">
                                <i class="bi bi-arrow-repeat me-2"></i>
                                Update Progress
                            </button>
                        </div>

                    </div>

                    <small class="text-muted d-block mt-2">
                        Enter a completion value between 0 and 100.
                    </small>

                </form>

            </section>
        }
    }

    <!-- Back to Dashboard -->
    <div class="mt-5">
        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-primary glass-button">
            <i class="bi bi-arrow-left me-2"></i>
            Back to Dashboard
        </a>
    </div>

</div>
```